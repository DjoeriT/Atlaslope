   "climate": {
    "text": "Mean annual temperature 9.7 °C, 14.1 °C in the growing season. Rain averages 760 mm a year, 60% of it in the growing season. Vines get on average 652,000 Wh/m² of direct sun in the season, highest on steep slopes.",
    "cite": [
     "mosel-spec:p8"
    ]
   },
   "soil": {
    "text": "Mostly Devonian rock: quartzite sandstone, quartzite and slate. Only the Upper Mosel has Muschelkalk and Keuper rock from lime-bearing marine deposits; Buntsandstein sandstone formed around Trier.",
    "cite": [
     "mosel-spec:p8",
     "mosel-spec:p12"
    ]
   },
   "altitude": {
    "text": "Vineyards lie about 65 to 375 m above sea level, averaging 180 m. Half face south-east to south-west, on average 195° (SSW).",
    "cite": [
     "mosel-spec:p8"
    ]
   },
   "tastes": {
    "text": "Whites: fruity, sometimes green, smoky or mineral, balanced acid and sweetness, light to full body. Reds: red fruit, mild to noticeable acidity, light to full-bodied.",
    "cite": [
     "mosel-spec:p2",
     "mosel-spec:p3"
    ]
   },
   "famous": {
    "styles": [
     {
      "name": "Kabinett",
      "text": "Low to moderate alcohol, fruity and fresh; at least 73° Öchsle (70° Elbling), unenriched."
     },
     {
      "name": "Auslese",
      "text": "Fully ripe or overripe grapes, sometimes botrytised; min. 88° Öchsle Riesling, 93° other whites."
     },
     {
      "name": "Trockenbeerenauslese",
      "text": "Berries concentrated further by noble rot; at least 150° Öchsle, mostly very sweet."
     },
     {
