   "climate": {
    "text": "Mean annual temperature 9.7 °C, 14.2 °C in the growing season. Rainfall about 665 mm a year, roughly 60% in the growing season. Long growing season and sheltered valley microclimates.",
    "cite": [
     "mittelrhein-spec:p8"
    ]
   },
   "soil": {
    "text": "Mostly Devonian slate, with quartzitic sandstone and some quartzite; brown earths and regosols dominate. Volcanic rock near Königswinter, loess and loam in places, sand and loam in the river plains.",
    "cite": [
     "mittelrhein-spec:p7",
     "mittelrhein-spec:p8"
    ]
   },
   "altitude": {
    "text": "Vineyards lie at about 55 to 350 m, 170 m on average, in a narrow valley over about 110 km long, facing south-south-east on average.",
    "cite": [
     "mittelrhein-spec:p7"
    ]
   },
   "tastes": {
    "text": "Whites: fresh fruit, floral and mineral notes, balanced acidity and sweetness, with Riesling and Burgundy grapes showing the rock underfoot. Reds: red fruit, light to full-bodied. Sparkling: fresh, fruity, acid-led.",
    "cite": [
     "mittelrhein-spec:p2",
     "mittelrhein-spec:p3",
     "mittelrhein-spec:p5"
    ]
   },
