   "climate": {
    "text": "Very mild, with dry-warm summers and mild winters, in the rain shadow of the wooded Taunus. Mean annual temperature is 10.6 °C (15.4 °C in the growing season), rainfall 582 mm and sunshine about 1603 hours.",
    "cite": [
     "rheingau-spec:p7",
     "rheingau-spec:p8"
    ]
   },
   "soil": {
    "text": "Mostly Rhine and Main terraces under thick loess or loess loam; phyllite and slate near the Taunus, and quartzite and slate rubble in the lower Rheingau.",
