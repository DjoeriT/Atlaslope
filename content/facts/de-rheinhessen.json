    ],
    "text": "Mostly varietal whites, plus reds, rosés, Rotling, sparkling and lightly sparkling wines, and sweet Prädikat wines up to Eiswein.",
    "cite": [
     "rheinhessen-spec:p1",
     "rheinhessen-spec:p2",
     "rheinhessen-spec:p3",
     "rheinhessen-spec:p4"
    ]
   },
   "climate": {
    "text": "Mean annual temperature is about 9.9 °C, 14.6 °C in the growing season. About 550 mm of rain falls a year, 65% of it (355 mm) in the growing season. Vines get roughly 650,000 Wh/m² of direct sun.",
    "cite": [
     "rheinhessen-spec:p7"
    ]
   },
   "soil": {
    "text": "Loess and loess loam are the main parent material. Plateaus are tertiary limestone, slopes and hills softer marl. Rotliegend rock surfaces only in the far southwest and at Nierstein, and Devonian quartzite and slate near Bingen.",
    "cite": [
     "rheinhessen-spec:p6",
     "rheinhessen-spec:p7"
    ]
   },
   "altitude": {
    "text": "Vines grow at 175 m on average. Plateaus reach 250 to 300 m and lowlands 100 to 150 m. Steep sites are mainly around Nierstein and Bingen.",
    "cite": [
     "rheinhessen-spec:p6",
     "rheinhessen-spec:p7"
    ]
   },
   "tastes": {
    "text": "Whites: mostly varietal, pale with green glints, yellow and tropical fruit, fresh. Riesling: pronounced acidity, minerality, elegant fruit. Reds: red fruit, soft acidity, restrained tannin. Rosés: medium body, red berries, lively acidity.",
    "cite": [
     "rheinhessen-spec:p2",
     "rheinhessen-spec:p3"
    ]
   },
   "famous": {
    "styles": [
     {
      "name": "Eiswein",
      "text": "Prädikat wine from healthy grapes frozen at harvest; at least 120° Öchsle."
     },
