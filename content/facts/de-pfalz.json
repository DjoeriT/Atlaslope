   },
   "climate": {
    "text": "Mean annual temperature is about 10 °C and 14.7 °C in the growing season, warmer from west to east. Rain is about 655 mm a year, 60% (390 mm) in the growing season.",
    "cite": [
     "pfalz-spec:p8"
    ]
   },
   "soil": {
    "text": "A large share on loess and loess loam; also river loams, sands and gravels, then Tertiary limestone and marl. Little sandstone; Muschelkalk, Keuper and Jurassic rocks are almost exotic.",
    "cite": [
     "pfalz-spec:p8"
    ]
   },
   "altitude": {
    "text": "Vineyards average about 170 m above sea level. Slopes reach 60% in the west, on the Pfälzerwald edge and Haardt edge; the plains are flat (under 10%).",
    "cite": [
     "pfalz-spec:p7",
     "pfalz-spec:p8"
    ]
   },
   "tastes": {
    "text": "Whites: fruity and fresh to exotic, with a balance of acid and sweetness and mostly strong body. Reds: berry and red fruit, mostly full-bodied, mild to noticeable acidity. Rosés: fruity and fresh.",
    "cite": [
     "pfalz-spec:p2",
     "pfalz-spec:p3"
    ]
   },
