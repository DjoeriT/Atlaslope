   "climate": {
    "text": "Mean temperature 9.3 °C a year and 13.8 °C in the growing season. Rainfall about 580 mm a year, 60% in the growing season. The river gives a mild climate with warm days and cool nights.",
    "cite": [
     "nahe-spec:p11",
     "nahe-spec:p13"
    ]
   },
   "soil": {
    "text": "Oldest rocks are Devonian sandstone, shale, quartzite, greenschist and phyllite. Rotliegend rock is by far the most widespread, with volcanic latite, andesite and basalt. Also tertiary sands and marl, slate, red sandstone, loess and loam.",
    "cite": [
     "nahe-spec:p11",
     "nahe-spec:p13"
    ]
   },
   "altitude": {
    "text": "Vineyards lie on average at about 210 m above sea level, on slopes averaging 12.5%. Steep sites include Rotenfels and Steinberg.",
    "cite": [
     "nahe-spec:p11"
    ]
   },
   "tastes": {
    "text": "Whites: fresh and fruity to rich and sweet, with sharp acidity and minerality. Reds: cherry and berry fruit, soft tannins, some oak spice. Rosé: fresh, lively acidity.",
    "cite": [
     "nahe-spec:p2",
     "nahe-spec:p3"
    ]
   },
   "famous": {
