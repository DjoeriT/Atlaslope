   "styles": {
    "kinds": [
     "red"
    ],
    "text": "Dry red wine, in Chianti, Chianti Superiore and Riserva versions, plus seven named subzones.",
    "cite": [
     "chianti-disc:p1",
     "chianti-disc:p33"
    ]
   },
   "climate": {
    "text": "Inland Tuscan hill climate, humid to sub-humid with a dry summer. Average rainfall is 867 mm a year, wettest in November (121 mm) and driest in July (32 mm). August averages over 23 °C, January about 5 °C.",
    "cite": [
     "chianti-disc:p35",
     "chianti-disc:p36"
    ]
   },
   "soil": {
    "text": "Very varied: sandstone, calcareous marl, clay schist and sand, sometimes mixed or leaning sandy or clayey, even within one estate.",
    "cite": [
     "chianti-disc:p35"
    ]
   },
   "altitude": {
    "text": "",
    "cite": []
   },
   "tastes": {
    "text": "Bright ruby turning garnet with age. Intense nose, sometimes violet. Dry, savoury, lightly tannic, softening to velvet. Riserva adds woodland berries and firmer tannin.",
    "cite": [
     "chianti-disc:p33"
    ]
   },
   "famous": {
    "styles": [
     {
      "name": "Chianti Superiore",
      "text": "Higher minimum alcohol (12%) and lower yield; sold from 1 September after harvest."
     },
     {
      "name": "Riserva",
      "text": "Aged at least 2 years, counted from 1 January after the harvest."
     },
     {
      "name": "Governo all'uso Toscano",
      "text": "Slow second fermentation of new wine with slightly dried grapes."
     },
     {
      "name": "Chianti Rufina",
      "text": "Subzone with at least 4,500 vines per hectare; 6 months in wood for Riserva."
     }
    ],
    "cite": [
