# Secrets (none today; the rule stays)
.env*
!.env.example

# Dependencies and build output
node_modules
dist/
playwright-report/
test-results/
.DS_Store

# Raw downloads stay out; only processed files in data/ are committed
data/raw/

# Claude: share agents, settings, skills and hooks; keep personal state out
.claude/*
!.claude/agents/
!.claude/settings.json
!.claude/skills/
!.claude/hooks/

# Mock runtime too large for the repo: copy from the project files to run a mock (Review/mock-*/README.md)
Review/mock-*/assets/data.js
Review/mock-*/assets/maplibre-gl.*
__pycache__/
.cache/
Tools/share/share.html

# Screenshots from Tools/shots.mjs
/shots/

# Local-only: the Claude pointer file and the satellite map mocks folder (docs/env-local.md)
CLAUDE.local.md
/mocks/

# Headless run transcripts (Tools/guides/headless.py): they hold local paths and account details; usage.py reads them locally.
Review/guides-pipeline/*/run*/
